{
  "expo": {
    "name": "Friendly",
    "slug": "friendly-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0A0A0F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.friendly.ai.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Friendly needs microphone access for voice calls.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio",
          "remote-notification"
        ]
      },
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0F"
      },
      "package": "com.friendly.ai.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "RECORD_AUDIO",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./src/assets/notification-icon.png",
          "color": "#6C5CE7",
          "sounds": [
            "./src/assets/sounds/call-ringtone.wav"
          ]
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Friendly needs microphone access for voice calls."
        }
      ],
      "expo-asset",
      "./plugins/withModularHeaders"
    ],
    "extra": {
      "eas": {
        "projectId": "745ef7be-33f5-4bfe-ab03-2a9f80cc97fd"
      }
    },
    "owner": "bonjenn"
  }
}
